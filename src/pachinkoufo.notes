# PACHINKO U.F.O. (Casio, 1984) - anotaciones
# ======================================================================
# EL MOTOR DE SONIDO (el mismo de Ski Command, Exciting Baseball y Exciting Jockey)
# ======================================================================
L 0xB9CF pieza                     Pone la pieza DE en el canal B y la hace sonar
C 0xB9D0 el canal, a su estado inicial
C 0xB9D3 el principio de la pieza
C 0xB9D7 suena
L 0xB9DB canal                     HL = el canal B (0xF102 + B x 0x20), y lo deja en su estado inicial (0xBC16)
D 0xBBFE 0xBC16 ordenes  Las doce ordenes del motor, de la 0xFF a la 0xF4
F 0xBBFE w2
D 0xBC16 0xBC26 canal_inicio  El estado inicial de un canal (desde +2): suena, la duracion, el volumen 15, la envolvente 0xBC3E...; la copia de 30 bytes sigue por la tabla de los periodos
D 0xBC26 0xBC3E periodos  Los periodos de las doce notas de la octava mas baja (do a si)
F 0xBC26 w12
C 0xB9E0 ...de 32 en 32 bytes
C 0xB9E3 B por 32
C 0xB9E8 HL, el canal...
C 0xB9E9 ...y desde +2...
C 0xB9EC ...30 bytes de 0xBC16
C 0xB9EF 30 bytes
L 0xB9F8 sonido_calla              Calla el sonido: los tres canales a cero, el PSG sin ruido y los volumenes a 0
C 0xB9F9 sin transporte
C 0xBA08 el registro 7 del PSG (RDPSG)...
C 0xBA0D ...los dos bits de los puertos se quedan...
C 0xBA0F ...los tonos apagados (0x38)...
C 0xBA14 ...WRTPSG
C 0xBA17 los tres canales, callados
L 0xBA28 canal_calla               El volumen del canal B a 0...
L 0xBA29 volumen                   ...y el volumen E en el registro 8 + B del PSG
C 0xBA2A el registro de volumen del canal
L 0xBA30 sonido_cuadro             Un cuadro del motor: los tres canales, del 2 al 0
C 0xBA32 empieza por el 2
C 0xBA48 suena?
C 0xBA4D el tempo: cada tantos cuadros...
C 0xBA50 ...aun no
C 0xBA51 el tempo...
C 0xBA54 ...vuelve a su cuenta
C 0xBA57 ...la nota acaba?...
C 0xBA5C ...se acaba lo que suena?
C 0xBA61 a cero, no menos
L 0xBA69 envolvente                La envolvente: el paso que toca segun lo que le queda a la nota, y su volumen de la tabla del canal
C 0xBA6C acabada?
C 0xBA6F lo que le queda...
C 0xBA72 ...por 16...
C 0xBA79 ...entre la duracion
C 0xBA7E ocho bits
L 0xBA80 envolvente_div            La division, bit a bit
C 0xBA81 el divisor...
C 0xBA86 ...cabe?
L 0xBA8C envolvente_bit            Un bit del cociente
C 0xBA92 16 menos el cociente: el paso de la envolvente
L 0xBA95 envolvente_paso           El paso: el volumen esta en la mitad alta o baja del byte de la tabla
C 0xBA98 16: la envolvente se ha acabado
C 0xBA9B el paso entre 2: el byte...
C 0xBA9D el paso par o impar
C 0xBAA1 ...de la envolvente
C 0xBAA4 la envolvente del canal
C 0xBAA9 el byte...
C 0xBAAA impar: la mitad baja
C 0xBAAC ...su mitad alta o baja
L 0xBAB0 envolvente_volumen        El volumen del paso por el volumen del canal, entre 16
C 0xBAB2 el volumen de la envolvente...
C 0xBAB4 ...por el del canal
C 0xBAB8 ocho bits
L 0xBABA envolvente_mult           La multiplicacion, bit a bit
L 0xBAC0 envolvente_mult_sig       El bit siguiente
C 0xBAC3 entre 16
C 0xBAE3 la rutina
C 0xBAE7 a la orden
L 0xBAE8 nota_pon                  Una nota: A el numero, E la duracion, D hasta la siguiente; duracion 0 es un silencio
C 0xBAE8 la duracion...
C 0xBAEB ...lo que le queda...
C 0xBAEE ...y hasta la siguiente
C 0xBAF1 duracion 0: silencio
C 0xBAFA ...mas la nota
C 0xBAFB la octava
L 0xBAFD nota_octava               La octava: de 12 en 12
C 0xBAFD de 12 en 12...
C 0xBB04 ...una octava mas
L 0xBB06 nota_periodo              El periodo de la nota (0xBC26), partido por 2 por cada octava
C 0xBB07 la nota de la tabla...
C 0xBB0A ...0xBC26
C 0xBB11 las octavas de mas...
L 0xBB15 nota_octava_baja          Una octava mas arriba
C 0xBB15 ...el periodo a la mitad
L 0xBB1C nota_escribe              El periodo en los registros 2B y 2B+1 del PSG
C 0xBB1C el registro 2B...
C 0xBB1E ...la parte baja...
C 0xBB27 ...y la alta
L 0xBB2A nota_envolvente           Si la envolvente es de las de tabla, desde el paso 0
C 0xBB2A la envolvente es de tabla?
C 0xBB30 desde el paso 0
L 0xBB3C orden_repite              Orden 0xFC: vuelve a la marca si faltan repeticiones
C 0xBB3C una repeticion menos...
C 0xBB3F ...si es la ultima, sigue
L 0xBB40 orden_vuelve              Orden 0xFD: vuelve a la marca
C 0xBB40 la marca...
C 0xBB46 ...por donde va
L 0xBB46 orden_salta               Orden 0xF4: salta a DE
L 0xBB4C orden_nada                Orden 0xFE: nada
L 0xBB4D orden_marca               Orden 0xFB: la marca de la repeticion y cuantas veces
C 0xBB4D cuantas veces...
C 0xBB50 ...y la marca es por donde va
L 0xBB5D orden_volumen             Orden 0xFA: el volumen del canal
C 0xBB5D el volumen, de 0 a 15
L 0xBB64 envolvente_psg            La envolvente del PSG: volumen 16 y los registros 11-13
C 0xBB64 el volumen 16: la envolvente del PSG
C 0xBB69 en el registro de volumen
C 0xBB75 ...el periodo en los registros 11...
C 0xBB7B ...y 12
L 0xBB7F orden_envolvente          Orden 0xF9: el tipo de envolvente: del PSG o de la tabla 0xBC3E
C 0xBB7F el tipo de envolvente...
C 0xBB82 ...bit 4: de tabla
C 0xBB86 la tabla: 8 bytes por envolvente...
C 0xBB93 ...la del canal
L 0xBB9A orden_tempo               Orden 0xF8: el tempo del canal (cuadros por paso)
L 0xBB9E orden_transporte          Orden 0xF7: el transporte, para los tres canales
L 0xBBA3 orden_mezcla              Orden 0xF6: tono y ruido del canal en el registro 7
C 0xBBA3 los bits de tono y ruido del canal...
C 0xBBA7 ...la mascara
L 0xBBAD orden_mezcla_bit          Los bits del canal
C 0xBBAD corridos al canal
L 0xBBB1 orden_mezcla_pon          Los escribe
C 0xBBB1 RDPSG 7
C 0xBBB7 fuera los del canal...
C 0xBBBA ...y los nuevos
C 0xBBBD los puertos de E/S como estaban
C 0xBBC0 WRTPSG 7
L 0xBBC5 orden_ruido               Orden 0xF5: el periodo del ruido y una nota de ruido
C 0xBBC5 fuera la vuelta...
C 0xBBC7 ...y los tres bytes siguientes
C 0xBBCB la duracion...
C 0xBBD1 ...y hasta la siguiente
C 0xBBD6 0: silencio
L 0xBBDE pieza_lee                 Los tres bytes siguientes de la pieza: A, E, D
C 0xBBDE el principio de la pieza...
C 0xBBE4 ...mas por donde va
C 0xBBEB tres mas
C 0xBBF4 el canal...
C 0xB9E1 B x 32 (tres rrca)
C 0xB9E4 en DE
C 0xB9E7 el canal
C 0xB9EA desde +2
D 0xBC3E 0xBC7E envolventes  Las ocho envolventes de tabla: 16 pasos de 4 bits (8 bytes cada una)
F 0xBC3E 8
#
# LA ROM: 16 KB en la pagina 2 (0x8000-0xBFFF). La cabecera es "AB" e INIT (0x81B3); el resto, a cero.
#
# USA LA BIOS: INIT llama a INITIO (0x003B), SETGRP (0x007E), CLRSPR (0x0069), INIGRP (0x0072), ERAFNK
# (0x00CC), CHGCLR (0x0062) y WRTVDP (0x0047), y lee la fuente de la BIOS por su direccion (0x0004); despues
# usa FILVRM, LDIRVM, WRTVRM (0x004D), RDVDP (0x013E), GTTRIG (0x00D8), SNSMAT (0x0141) y WRTPSG/RDPSG.
#
# LA INTERRUPCION va por el gancho H.KEYI (0xFD9A), no por H.TIMI: 0x8010 lee el estado del VDP, hace el
# cuadro y, al volver, salta dos bytes mas alla en la rutina de la BIOS que la ha llamado.
#
# EL JUEGO: una maquina de pachinko con un OVNI en el centro. El boton 1 sostenido carga la fuerza y al
# soltarlo sale la bola; el boton 2 para el tragaperras de tres cifras del centro.
#
# LA RAM, lo que se lee en el listado:
#   0xEC50 el record y 0xEC55 los puntos (3 bytes BCD)   0xEC59 partidas   0xEC5A la maquina (0, 1, 2: una tras otra)
#   0xEC5B LEVEL: las vueltas a las tres maquinas (BCD)   0xEC5C la vuelta (0-2)   0xEC5D el objetivo (0-3)   0xEC5E la demostracion (0 = no)
#   0xEC7B la fuerza (0-15)   0xEC7C la bola en el lanzador   0xEC7D las bolas (binario)
#   0xEC85-0xEC88 el tragaperras del centro   0xECE4 las ocho bolas en juego (8 bytes cada una)
#   0xED25 / 0xED26 los botones 1 y 2   0xED28 un contador de cuadros   0xED2A el final (1 clear, 2 sin bolas)
#   0xED2C el objetivo (CLEAR) y 0xED2E las bolas (BCD)   0xEFFF lo que acaba la partida   0xF000 la interrupcion ocupada
#   0xF100-0xF15F el motor de sonido
# ======================================================================
# LA INTERRUPCION Y LAS RUTINAS DE SERVICIO
# ======================================================================
D 0x8000 0x8010 cabecera  "AB", INIT (0x81B3) y el resto de la cabecera a cero
F 0x8000 2,w,12
L 0x8010 interrupcion              La interrupcion (H.KEYI): el estado del VDP, el cuadro y la vuelta a la BIOS dos bytes mas alla
C 0x8010 RDVDP: lee el estado (y el VDP deja de pedir la interrupcion)
C 0x8013 el cuadro
C 0x8016 la vuelta a la BIOS...
C 0x8017 ...dos bytes mas alla...
C 0x8019 ...con A = 0...
C 0x801A ...salta alli
L 0x801B cuadro                    Un cuadro: el sonido (si no es la demostracion) y, si el anterior ha acabado, el juego
C 0x801B la demostracion?
C 0x801F no: el sonido
C 0x8022 el cuadro anterior aun corre?
C 0x8027 con las interrupciones abiertas
C 0x8028 ocupado
C 0x802C el juego
C 0x802F la partida se acaba?
C 0x8033 cerradas
C 0x8035 libre
L 0x8039 espera                    Una espera de unos 200.000 pasos (tres vueltas de 65.536), salvo en la demostracion
C 0x8039 la demostracion?
C 0x803E tres vueltas
L 0x8041 espera_vuelta             ...DE desde 0...
L 0x8043 espera_paso               ...hasta 0 otra vez
L 0x804C ocupado                   0xF000 a 0xFF: la interrupcion no hace el juego
L 0x8051 libre                     0xF000 a 0: la interrupcion hace el juego
L 0x8053 ocupado_pon
L 0x8058 boton2                    El boton 2: B del mando 1 o 2 (GTTRIG 3 y 4) o GRAPH (fila 6, bit 2), 0xFF en 0xED26
C 0x8058 el mando 1...
C 0x8060 ...el 2...
C 0x8068 ...o el teclado: la fila 6 (SNSMAT)
C 0x806D GRAPH a 0 = pulsada
L 0x8074 boton2_pon
L 0x8078 boton1                    El boton 1: A del mando 1 o 2 o la barra (GTTRIG 1, 2 y 0), en 0xED25
C 0x8078 el mando 1...
C 0x8080 ...el 2...
C 0x8088 ...o la barra
L 0x808C boton1_pon
L 0x8090 texto_vram                Escribe en la VRAM el texto que va detras del "call": la direccion y las letras hasta 0x00; vuelve detras
C 0x8090 la vuelta: los datos
C 0x8091 la direccion de la VRAM...
C 0x8095 ...en HL
L 0x8096 texto_vram_letra          Una letra (WRTVRM)
C 0x8098 0: se acaba
L 0x80A1 texto_vram_fin            La vuelta, detras del 0
L 0x80A3 copia_ram                 Copia a la RAM los bytes que van detras del "call": la direccion y los bytes hasta 0x1F; vuelve detras
C 0x80A3 la vuelta: los datos
C 0x80A4 la direccion de la RAM...
L 0x80A9 copia_ram_byte            Un byte
C 0x80AB 0x1F: se acaba
L 0x80B3 copia_ram_fin             La vuelta, detras del 0x1F
L 0x80B5 titulo                    El titulo: la pantalla en blanco, los sprites fuera, CASIO, PACHINKO-U.F.O., PUSH TRIGGER 1 TO START GAME y el copyright
C 0x80B5 el espacio...
C 0x80B7 ...en toda la pantalla
C 0x80BA los sprites fuera
L 0x8162 titulo_espera             Espera DE vueltas al boton 1; si llega a 0, la demostracion (0xEC5E = 1)
C 0x8162 el boton 1
C 0x8168 pulsado?
C 0x816B una vuelta menos
C 0x8170 nadie: la demostracion
L 0x8175 titulo_boton              El boton: la partida, con el sonido callado
D 0x817D 0x818D niveles  Los cuatro objetivos: las bolas que hay que hacer (binario: 400, 600, 800 y 1000) y el CLEAR en BCD
F 0x817D 4
D 0x818D 0x81B3 tabla_818d  Los dos bytes de cada vuelta de la maquina 2 (0xED30, 0xED31: lo que quita el OVNI malo y lo que da el bueno), y desde 0x8193 la Y y la X del lanzador por la fuerza (16 parejas)
F 0x818D 2
# ======================================================================
# INIT Y LA PARTIDA
# ======================================================================
L 0x81B3 init                      El arranque: la pila, la interrupcion en H.KEYI, SCREEN 2, la fuente de la BIOS en los tres tercios y la partida
C 0x81B4 la pila
C 0x81B7 el "jp"...
C 0x81BC ...a 0x8010...
C 0x81BF ...en H.KEYI
C 0x81C2 la interrupcion no hace el juego
C 0x81C5 INITIO
C 0x81C8 SETGRP
C 0x81CB el sonido callado
C 0x81CE CLRSPR
C 0x81D1 INIGRP: SCREEN 2
C 0x81D4 ERAFNK
C 0x81D7 la pantalla en blanco
C 0x81DC el color del borde: 1
C 0x81E1 CHGCLR
C 0x81E4 el registro 1 a 0xE2: sprites de 16 x 16
C 0x81EA el registro 2...
C 0x81F0 la fuente de la BIOS (la direccion de 0x0004)...
C 0x81F3 ...2 KB...
C 0x81F6 ...desde 0
L 0x81F8 init_fuente               ...en los tres tercios de la tabla de patrones (LDIRVM)
C 0x8204 hasta 0x1800
C 0x8209 los dibujos del juego
C 0x820C la pantalla de la maquina
C 0x820F la RAM 0xE000-0xEFFF a cero
C 0x821C el record: 10000 (0x01, BCD)
C 0x8221 los dibujos de los sprites
L 0x8224 partida_nueva             El titulo, la espera y una partida nueva
C 0x8224 el titulo
C 0x8236 la demostracion?
C 0x823C una maquina al azar (0-3; la ronda pasa a la siguiente)
L 0x8243 partida_ronda             Una ronda: la RAM de la ronda a cero y la maquina siguiente; tras las tres, otra vuelta y LEVEL + 1; tras tres vueltas, el objetivo siguiente
C 0x8245 256 bytes desde 0xEC61
L 0x8248 partida_borra
C 0x824D la maquina
C 0x8250 una partida mas
C 0x8255 la maquina siguiente...
C 0x8257 ...pasa de 2?
C 0x825B la vuelta siguiente...
C 0x8263 el objetivo siguiente (de 0 a 3)
L 0x826D partida_vuelta
C 0x8270 LEVEL, uno mas (BCD)
L 0x8278 partida_nivel             Las bolas del objetivo (0x817D)
C 0x8279 el objetivo x 4
C 0x8285 las bolas que hay que hacer (binario)...
C 0x828D ...y en BCD, para el CLEAR
C 0x8294 50 bolas en BCD
C 0x8299 50 en binario
C 0x829E la maquina
L 0x8300 partida_limpia
L 0x8315 partida_marcas
L 0x8320 partida_maq1             La maquina 1
L 0x8328 partida_maq0             La maquina 0: en la primera partida, la musica de la salida (0xBC7E, 0xBCFA, 0xBD61)
L 0x834D partida_pantalla
L 0x8386 partida_textos
L 0x83E6 partida_maq1_borra
L 0x83F7 partida_marcador          El marcador: HIGH-SCORE, SCORE, CLEAR, las bolas y LEVEL
L 0x8466 partida_espera            Espera al boton 1 para empezar
L 0x8471 partida_maq2             La maquina 2: su musica (0xBE2A)
L 0x847B partida_calla             El sonido callado
L 0x847E partida_juega             La interrupcion hace el juego hasta que deja algo en 0xEFFF
L 0x8481 partida_juega_espera
C 0x8487 la interrupcion deja de hacer el juego
C 0x848B la espera
C 0x848F 1?
C 0x8492 2?
L 0x84AE game_over                 GAME OVER y su musica (0xBE76, 0xBEA7, 0xBED8); despues, el titulo
L 0x84D5 pattern_clear             PATTERN CLEAR y su musica (0xBF03, 0xBF22, 0xBF41); la maquina 2, LEVEL CLEAR
L 0x8515 level_clear               La maquina 2: LEVEL CLEAR y su musica (0xBF60, 0xBF79, 0xBF92); en la demostracion, al titulo
L 0x854D cartel_game_over          Los sprites fuera y GAME OVER
L 0x8562 espera_musica             Espera a que acabe la musica, salvo en la demostracion
L 0x8567 espera_musica_va          ...los tres canales callados?
L 0x8577 puntos_suena              Puntos (DE) y el sonido (0xBE5C, canal 1)
L 0x858D bola_menos                Una bola menos: en las bolas (0xEC7D y 0xED2E) y en los puntos
L 0x8599 bola_menos_va
C 0x8599 una menos en binario
C 0x85A0 una menos en BCD
C 0x85B6 en la pantalla
C 0x85B9 y un punto menos (BCD, tres bytes)
L 0x85DB puntos                    DE bolas mas y DE puntos mas (salvo en un caso), y el record si se pasa
C 0x85E6 en binario
C 0x85F0 en BCD
C 0x8604 en la pantalla
C 0x8608 los puntos (BCD, tres bytes)
C 0x8625 en la pantalla
C 0x8628 pasa del record?
L 0x8649 record                    El record nuevo, salvo en la demostracion
L 0x8662 pinta_clear               El CLEAR (0xED2C) en la pantalla
L 0x866B pinta_bolas               Las bolas (0xED2E)
L 0x8672 pinta_dos                 Dos bytes BCD: cuatro cifras
L 0x8683 pinta_record              El record (0xEC50)
L 0x868C pinta_puntos              Los puntos (0xEC55)
L 0x8693 pinta_tres                Tres bytes BCD: seis cifras
L 0x86AC pinta_nivel               LEVEL (0xEC5B)
L 0x86B8 pinta_byte                Las dos cifras de un byte BCD; los ceros de la izquierda en blanco
L 0x86C7 pinta_alta
L 0x86C8 pinta_cifra               La cifra (0x30 + n, WRTVRM)
L 0x86CF pinta_baja                La cifra baja
L 0x86DA pinta_baja_va
L 0x86DB pinta_baja_cifra
L 0x86E2 cero_blanco               Un 0 a la izquierda: en blanco (0xF0 - 0x30 = espacio), salvo la ultima cifra
L 0x86F1 cero_fin
# ======================================================================
# EL CUADRO DEL JUEGO
# ======================================================================
L 0x86F2 juego                     Un cuadro del juego (desde la interrupcion): la demostracion, el lanzador, el centro, las bolas, el marcador y el final
C 0x86F2 la demostracion
C 0x86F6 un cuadro mas
C 0x86FD cada 256 cuadros...
C 0x86FF ...en la demostracion...
C 0x8703 ...una cuenta mas...
C 0x8707 ...a la 10...
C 0x870B ...se acaba (2)
L 0x8710 juego_demo                En la demostracion, el boton 1 la acaba
C 0x8714 el boton 1
C 0x871D se acaba (2)
L 0x8723 juego_cuadro              Las partes del cuadro
C 0x8723 el lanzador y la bola nueva
C 0x8726 el centro abierto o cerrado
C 0x8729 el tragaperras
C 0x872C las bolas
C 0x872F los molinillos
C 0x8732 los OVNIs de la maquina 2
C 0x8735 los sprites
C 0x873E la fuerza en la pantalla
C 0x8741 el record llega a 100.000?...
C 0x8748 ...se acaba la partida (3)...
C 0x874D ...con 99.999 (se ven cinco cifras)...
C 0x875A ...en la pantalla
L 0x8760 juego_mil                 Con 1000 bolas justas, nada de final
C 0x8760 las bolas...
C 0x8763 ...1000?
L 0x876F juego_9000                9000 o mas: vuelven a 0
C 0x8772 9000?
L 0x877F juego_sin_bolas           Sin bolas: el final 2 (GAME OVER)
L 0x878D juego_objetivo            Mas bolas que el objetivo y sin premio en marcha: el final 1 (CLEAR); la maquina 2 no tiene objetivo
C 0x8794 las bolas, con los bytes al reves (BCD)
C 0x879B el objetivo
C 0x87A1 el objetivo menos las bolas
C 0x87A6 hay premio en marcha?
L 0x87B0 juego_final               Con un final pendiente: cuando no queda ninguna bola en juego (o pasan 192 cuadros), a 0xEFFF
C 0x87B5 la cuenta del final
C 0x87C0 las ocho bolas...
L 0x87C9 juego_final_bola          ...alguna en juego?
L 0x87CE juego_final_va            El final
L 0x87D5 fuerza_pinta              Cada 16 cuadros, la fuerza y las bolas en la casilla del lanzador
C 0x87D5 cada 16 cuadros
C 0x87DB la maquina 2 no
C 0x87E1 lo que se ha cargado...
C 0x87E4 ...no mas de 4
L 0x87EA fuerza_casilla            La casilla de la tabla 0xA4E7...
C 0x87F3 ...y las bolas entre 16...
C 0x87FC ...no mas de 10...
L 0x8802 fuerza_sitio              ...el sitio en la pantalla
L 0x8812 fuerza_pon                WRTVRM
L 0x8815 molinillos                Los cuatro molinillos (0xEC64, 6 bytes): mientras les queda cuenta, giran mas deprisa al principio
C 0x8815 la maquina 2 no tiene
C 0x881B cuatro
L 0x8820 molinillo                 Uno: le queda cuenta?
C 0x8825 una menos
C 0x8827 los dos bits altos: lo que gira
C 0x8830 el dibujo...
C 0x8831 ...gira (de 0 a 7)
L 0x8835 molinillo_sig             El siguiente
L 0x883D cuenta_ix                 Una cuenta menos en IX+3; a 0, IX+0 = 4 y otra vez 40
L 0x884E ovnis                     La maquina 2: cada cuatro cuadros, los cinco OVNIs (0xECC5, 5 bytes) se mueven segun su estado
C 0x884E solo la maquina 2
C 0x8854 cada 4 cuadros
C 0x885A los cinco OVNIs
L 0x8860 ovni                      Uno: su estado
C 0x8865 0: quieto
C 0x8868 1: a la derecha
C 0x886B 2: a la izquierda
C 0x886E 3: espera
C 0x8870 4 o mas: una cuenta...
C 0x8879 ...y al azar a 1 o a 2
L 0x8886 ovni_espera               Estado 3: la cuenta
L 0x888B ovni_izquierda            Estado 2: a la izquierda; en X 0x30, a la derecha
L 0x889F ovni_derecha              Estado 1: a la derecha; en X 0x90, a la izquierda
L 0x88B1 ovni_dibujo               Cada 8 cuadros, el dibujo siguiente (0-3)
