# Puntos de entrada que el trazado NO puede deducir solo.
#
# Cada uno lleva escrito POR QUE hace falta.

# El arranque: la cabecera da INIT en 0x81B3.
0x81B3   # INIT

# La interrupcion: INIT pone en el gancho H.KEYI (0xFD9A) un "jp 0x8010" (0x81B7-0x81BF).
0x8010
0x80CF   # vuelta de la llamada a 0x8090 con datos detras
0x80E1   # vuelta de la llamada a 0x8090 con datos detras
0x8101   # vuelta de la llamada a 0x8090 con datos detras
0x8122   # vuelta de la llamada a 0x8090 con datos detras
0x8144   # vuelta de la llamada a 0x8090 con datos detras
0x8160   # vuelta de la llamada a 0x8090 con datos detras
0x8236   # vuelta de la llamada a 0x80A3 con datos detras
0x82D9   # vuelta de la llamada a 0x80A3 con datos detras
0x83A4   # vuelta de la llamada a 0x80A3 con datos detras
0x83E6   # vuelta de la llamada a 0x80A3 con datos detras
0x840C   # vuelta de la llamada a 0x8090 con datos detras
0x8417   # vuelta de la llamada a 0x8090 con datos detras
0x84AE   # vuelta de la llamada a 0x8090 con datos detras
0x850F   # vuelta de la llamada a 0x8090 con datos detras
